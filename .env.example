# PokerTH LLM eval harness — example config.
# Copy to ".env" (in the directory you launch pokerth_qml-client from), or to
# ~/.pokerth_llm.env, or point POKERTH_LLM_ENV at any path. Real environment
# variables override values set here.
#
#   cp .env.example .env   &&   $EDITOR .env

# Turn the autonomous LLM player on (1) or off (0).
POKERTH_LLM_ENABLE=1

# Full OpenAI-compatible chat-completions URL of your model server (required).
# Ollama on the LAN:
POKERTH_LLM_ENDPOINT=http://192.168.1.50:11434/v1/chat/completions
# Cloud example:
# POKERTH_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Model name as the server expects it.
POKERTH_LLM_MODEL=llama3.1:8b

# Optional bearer token (leave blank for most LAN servers; required for cloud APIs).
#POKERTH_LLM_API_KEY=sk-...

# Optional tuning.
#POKERTH_LLM_TEMPERATURE=0.7
#POKERTH_LLM_TIMEOUT_MS=30000
# Set to 0 if your server rejects response_format=json_object.
#POKERTH_LLM_JSON_MODE=1
# Max output tokens per decision (give reasoning models room before the JSON).
#POKERTH_LLM_MAX_TOKENS=8192
# Context window (tokens) for the on-screen %; auto-detected from llama.cpp /props.
#POKERTH_LLM_CONTEXT=131072
# Finished hands of session memory fed to the model (full betting + outcome each).
#POKERTH_LLM_HISTORY_HANDS=40
# Reasoning hydration (experimental): replay last N decisions WITH their full
# chain-of-thought so the model builds on its own reasoning. 0=off. Adds ~1.5-2k
# tokens/turn (raise n_ctx; turns get slower). Try 6-10 to test.
#POKERTH_LLM_REASONING_TURNS=8
# Decision log path (default: ~/pokerth_llm_eval.jsonl).
#POKERTH_LLM_LOG=/home/pi/pokerth_llm_eval.jsonl
